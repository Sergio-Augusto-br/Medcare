# Ambiente local. Execute `pnpm supabase:start` e `pnpm supabase:status`.
VITE_SUPABASE_URL=http://127.0.0.1:54321
# Preencha com PUBLISHABLE_KEY (ou ANON_KEY em versões antigas) exibida pelo status local.
VITE_SUPABASE_PUBLISHABLE_KEY=

# Opcional. O identificador público será usado quando o OneSignal for integrado.
VITE_ONESIGNAL_APP_ID=
